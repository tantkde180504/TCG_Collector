rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra người dùng hiện tại có phải admin/super_admin không
    function isAdmin() {
      return request.auth != null && 
        (
          resource.data.role == 'admin' || 
          resource.data.role == 'super_admin' || 
          resource.data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    // Cấu hình phân quyền cho users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Cho phép Admin đọc & cập nhật thông tin người dùng
      allow read, update: if isAdmin();

      // Cấu hình phân quyền cho orders nằm trong users
      match /orders/{orderId} {
        // Người dùng có thể đọc & ghi đơn hàng của chính họ
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Cấu hình phân quyền cho cart nằm trong users
      match /cart/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cấu hình phân quyền cho addresses nằm trong users
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 🔥 QUAN TRỌNG NHẤT: Cấp quyền cho tính năng collectionGroup('orders') của Admin
    match /{path=**}/orders/{orderId} {
      allow read, update: if isAdmin();
    }
    
    // Cấu hình phân quyền cho cards
    match /cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
